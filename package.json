{
  "name": "baton",
  "displayName": "Baton",
  "description": "Route coding tasks from your VS Code sidebar.",
  "version": "0.0.1",
  "publisher": "ogroprojukti",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "keywords": [
    "ai",
    "relay",
    "agent",
    "gemma",
    "ollama",
    "chatgpt",
    "gemini",
    "claude",
    "mcp"
  ],
  "icon": "media/baton-watermark.png",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ogro-Projukti/baton"
  },
  "bugs": {
    "url": "https://github.com/Ogro-Projukti/baton/issues"
  },
  "homepage": "https://github.com/Ogro-Projukti/baton#readme",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:baton.sessions",
    "onCommand:baton.openEditor",
    "onCommand:baton.newSession",
    "onCommand:baton.focus",
    "onCommand:baton.setKeys",
    "onCommand:baton.copyMcpConfig",
    "onCommand:baton.kb.openSources",
    "onCommand:baton.kb.openAvailability",
    "onCommand:baton.kb.previewSource",
    "onCommand:baton.kb.update",
    "onCommand:baton.kb.showCandidates",
    "onCommand:baton.kb.resetStats"
  ],
  "contributes": {
    "commands": [
      {
        "command": "baton.openEditor",
        "title": "Baton: Open Chat Panel"
      },
      {
        "command": "baton.newSession",
        "title": "Baton: New Task"
      },
      {
        "command": "baton.focus",
        "title": "Baton: Focus Task Manager"
      },
      {
        "command": "baton.setKeys",
        "title": "Baton: Set API Keys"
      },
      {
        "command": "baton.copyMcpConfig",
        "title": "Baton: Copy MCP Config"
      },
      {
        "command": "baton.kb.openSources",
        "title": "Baton: Open Knowledge Base Sources"
      },
      {
        "command": "baton.kb.openAvailability",
        "title": "Baton: Open Knowledge Base Availability"
      },
      {
        "command": "baton.kb.previewSource",
        "title": "Baton: Preview Knowledge Base Source"
      },
      {
        "command": "baton.kb.update",
        "title": "Baton: Update Knowledge"
      },
      {
        "command": "baton.kb.showCandidates",
        "title": "Baton: Show Knowledge Base Candidates"
      },
      {
        "command": "baton.kb.resetStats",
        "title": "Baton: Reset Stats"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "baton",
          "title": "Baton",
          "icon": "media/baton.svg"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "baton.local-context",
        "label": "Baton local context"
      }
    ],
    "views": {
      "baton": [
        {
          "type": "webview",
          "id": "baton.sessions",
          "name": "TASK MANAGER"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run check && npm run build",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "test": "esbuild tests/task-flow.test.ts --bundle --platform=node --target=node18 --external:vscode --outfile=dist/task-flow.test.cjs && node --test dist/task-flow.test.cjs",
    "eval": "esbuild scripts/eval.ts --bundle --platform=node --target=node18 --outfile=dist/eval.cjs && node dist/eval.cjs",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "~1.85.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@google/genai": "1.0.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "minisearch": "^7.2.0",
    "node-html-parser": "^9.0.5",
    "zod": "^3.25.76"
  }
}
